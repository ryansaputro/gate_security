INTERFACE=HTTP
HTTP_PORT=3000
ENVIRONMENT=dev
BASE_PATH=

# Auth (set to false to disable auth in dev)
AUTH_ENABLED=false

MONGO_URI=mongodb://localhost:27017
MONGO_DB=gate_security

# Email / SMTP
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gate Security System

# Gate Client (used by CMD/OCR interface)
GATE_API_URL=http://localhost:3000
GATE_API_KEY=
GATE_ID=gate_1
GATE_DIRECTION=entry
GATE_COOLDOWN=10
GATE_OPEN_METHOD=log
# GATE_OPEN_METHOD=gpio
# GATE_GPIO_PIN=17
# GATE_OPEN_DURATION=3
# GATE_OPEN_METHOD=http
# GATE_OPEN_URL=http://192.168.1.100/open

# Live Monitor (web-based camera stream)
YOLO_MODEL_PATH=models/plate_best.pt
OCR_CONFIDENCE=0.4
OCR_INTERVAL=1.5
OCR_VOTE_THRESHOLD=2
OCR_IPC_DIR=/tmp/ocr-live
# CAMERA_0_URL=rtsp://user:pass@192.168.1.100:554/live/ch00_0
# CAMERA_1_URL=rtsp://user:pass@192.168.1.101:554/live/ch00_0

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Google Sheet Sync (Dues)
GSHEET_DUES_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/gviz/tq?tqx=out:csv&sheet=Sheet1
GSHEET_SYNC_INTERVAL_MINUTES=60
