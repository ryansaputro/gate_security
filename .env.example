INTERFACE=HTTP
HTTP_PORT=3000
ENVIRONMENT=dev
BASE_PATH=

# Auth (set to false to disable auth in dev)
AUTH_ENABLED=false

MONGO_URI=mongodb://localhost:27017
MONGO_DB=gate_security

# Email / SMTP
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gate Security System

# Gate Client (used by CMD/OCR interface)
GATE_API_URL=http://localhost:3000
GATE_API_KEY=
GATE_ID=gate_1
GATE_DIRECTION=entry
GATE_COOLDOWN=10
GATE_OPEN_METHOD=log
